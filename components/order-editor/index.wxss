.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 18rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.muted {
  color: rgba(0, 0, 0, 0.55);
}
.small {
  font-size: 24rpx;
}
.line {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}
.edit-line {
  align-items: flex-start;
  gap: 12rpx;
}
.line-main {
  flex: 1;
  min-width: 0;
}
.line-side {
  min-width: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.line-total {
  font-weight: 600;
}
.qty-ops {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}
.op-btn {
  min-width: 52rpx;
  height: 44rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.qty {
  min-width: 40rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}
.danger {
  color: #d93025;
  border-color: rgba(217, 48, 37, 0.5);
}
.hr {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.06);
  margin: 14rpx 0;
}
.sum {
  font-weight: 800;
  font-size: 32rpx;
}
.action-row {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}
.action-row.single .btn {
  flex: 1 1 100%;
}
.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
}
.ghost {
  background: #fff;
  color: #111;
  border: 1rpx solid rgba(0, 0, 0, 0.2);
}
.danger-btn {
  background: #d93025;
  color: #fff;
}
.btn::after {
  border: none;
}

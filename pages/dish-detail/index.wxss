page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7fb;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.page {
  padding: 24rpx;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 18rpx;
}
.muted {
  color: rgba(0, 0, 0, 0.55);
}
.sw {
  width: 100%;
  height: 520rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.04);
}
.img {
  width: 100%;
  height: 520rpx;
}
.name {
  margin-top: 16rpx;
  font-size: 38rpx;
  font-weight: 800;
}
.price {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(0, 0, 0, 0.7);
}
.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.btn.ghost {
  background: transparent;
  color: #111;
  border: 1rpx solid rgba(0, 0, 0, 0.18);
  border-radius: 16rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin-top: 16rpx;
}


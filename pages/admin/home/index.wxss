page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7fb;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.page {
  padding: 24rpx;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 18rpx;
}
.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.muted {
  color: rgba(0, 0, 0, 0.55);
}
.small {
  font-size: 24rpx;
}
.row {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 14rpx;
}
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
.btn {
  background: #111;
  color: #fff;
  border-radius: 18rpx;
  height: 78rpx;
  line-height: 78rpx;
}
.btn.ghost {
  background: transparent;
  color: #111;
  border: 1rpx solid rgba(0, 0, 0, 0.18);
}
.btn.danger {
  background: #b00020;
  color: #fff;
}
.sale {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}
.sale:first-child {
  border-top: none;
}
.strong {
  font-weight: 700;
}


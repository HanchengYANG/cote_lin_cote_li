<navigation-bar title="生产管理" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<sync-guard ready="{{isReady}}" error="{{syncError}}" bindretry="onSyncRetry"></sync-guard>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="card" wx:if="{{loadPhase!=='ready'}}">
      <view class="muted">载入中...</view>
    </view>

    <block wx:else>
      <view class="card">
        <view class="title">选择开单</view>
        <picker mode="selector" range="{{saleOptions}}" range-key="label" value="{{saleIndex}}" bindchange="onPickSale">
          <view class="picker">开单：{{saleLabel}}</view>
        </picker>
        <view class="muted small" wx:if="{{loadingSales || loadingBoard}}">加载中...</view>
      </view>

      <view class="card" wx:if="{{!sale}}">
        <view class="muted">暂无可查看生产进度的开单</view>
      </view>

      <block wx:else>
        <view class="card">
          <view class="title">生产进度</view>
          <view class="muted small">开单状态：{{sale.statusText || sale.status}}</view>
          <view class="muted small" wx:if="{{sale.deliveryTimeSlotLabel}}">时间段：{{sale.deliveryTimeSlotLabel}}</view>
          <view class="muted small warn" wx:if="{{productionDirty}}">当前有未保存修改</view>
          <view class="progress-head">
            <view class="progress-percent">{{productionDraft.completionPercent || 0}}%</view>
            <view class="muted small">已生产 {{productionDraft.totalPreparedPieceQty || 0}} / {{productionDraft.totalNeedPieceQty || 0}} 个</view>
          </view>
          <view class="muted small">共 {{productionDraft.totalNeedOrderQty || 0}} 份</view>
          <view class="progress-track">
            <view class="progress-bar" style="width: {{productionDraft.completionPercent || 0}}%;"></view>
          </view>
          <view class="muted small warn" wx:if="{{!canEdit}}">仅 CLOSED 状态可编辑生产进度</view>
        </view>

        <view class="card">
          <view class="title">菜品清单</view>
          <view class="muted" wx:if="{{loadingBoard}}">加载生产清单中...</view>
          <view class="muted" wx:elif="{{productionDraft.items.length===0}}">暂无菜品生产数据</view>
          <block wx:else>
            <view class="row-item" wx:for="{{productionDraft.items}}" wx:key="dishId">
              <view class="row-main">
                <view class="dish-name">{{item.dishName}}</view>
                <view class="muted small">需做 {{item.needPieceQty}} 个</view>
                <view class="muted small">已售 {{item.needOrderQty}} 份</view>
                <view class="muted small" wx:if="{{item.isOver}}">已超量生产</view>
              </view>
              <view class="row-side">
                <view class="prepared {{item.isDone ? 'done' : ''}}">{{item.preparedPieceQty}} / {{item.needPieceQty}} 个</view>
                <view class="ops ops-wide" wx:if="{{canEdit}}">
                  <button class="icon-btn" size="mini" catchtap="onAdjustPrepared" data-id="{{item.dishId}}" data-delta="-1" disabled="{{loadingBoard || savingBoard || completingAll || item.preparedPieceQty<=0}}">-1</button>
                  <input class="qty-input" type="number" value="{{item.preparedPieceQtyInput}}" bindinput="onPreparedInput" data-id="{{item.dishId}}" />
                  <button class="icon-btn plus" size="mini" catchtap="onAdjustPrepared" data-id="{{item.dishId}}" data-delta="1" disabled="{{loadingBoard || savingBoard || completingAll}}">+1</button>
                  <button class="icon-btn plus-ten" size="mini" catchtap="onAdjustPrepared" data-id="{{item.dishId}}" data-delta="10" disabled="{{loadingBoard || savingBoard || completingAll}}">+10</button>
                </view>
              </view>
            </view>
          </block>
          <view class="actions" wx:if="{{canEdit}}">
            <button class="action-btn save" loading="{{savingBoard}}" disabled="{{loadingBoard || savingBoard || completingAll || !productionDirty}}" bindtap="onSaveProductionBoard">💾 保存进度</button>
            <button class="action-btn complete" loading="{{completingAll}}" disabled="{{loadingBoard || savingBoard || completingAll || !productionDraft.items.length}}" bindtap="onCompleteAllPrepared">✅ 一键完成</button>
          </view>
        </view>
      </block>
    </block>
  </view>
</scroll-view>


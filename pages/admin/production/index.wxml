<navigation-bar title="生产管理" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<sync-guard ready="{{isReady}}" error="{{syncError}}" bindretry="onSyncRetry"></sync-guard>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="card" wx:if="{{initialLoading}}">
      <view class="muted">载入中...</view>
    </view>

    <block wx:else>
      <view class="card">
        <view class="title">选择开单</view>
        <picker mode="selector" range="{{saleOptions}}" range-key="label" value="{{saleIndex}}" bindchange="onPickSale">
          <view class="picker">开单：{{saleLabel}}</view>
        </picker>
        <view class="muted small" wx:if="{{loadingSales || loadingBoard}}">加载中...</view>
      </view>

      <view class="card" wx:if="{{!sale}}">
        <view class="muted">暂无可查看生产进度的开单</view>
      </view>

      <block wx:else>
        <view class="card">
          <view class="title">生产进度</view>
          <view class="muted small">开单状态：{{sale.statusText || sale.status}}</view>
          <view class="muted small" wx:if="{{sale.deliveryTimeSlotLabel}}">时间段：{{sale.deliveryTimeSlotLabel}}</view>
          <view class="progress-head">
            <view class="progress-percent">{{production.completionPercent || 0}}%</view>
            <view class="muted small">已生产 {{production.totalPreparedQty || 0}} / {{production.totalNeedQty || 0}}</view>
          </view>
          <view class="progress-track">
            <view class="progress-bar" style="width: {{production.completionPercent || 0}}%;"></view>
          </view>
          <view class="muted small warn" wx:if="{{!canEdit}}">仅 CLOSED 状态可编辑生产进度</view>
        </view>

        <view class="card" wx:if="{{loadingBoard}}">
          <view class="muted">加载生产清单中...</view>
        </view>

        <view class="card" wx:elif="{{production.items.length===0}}">
          <view class="title">菜品清单</view>
          <view class="muted">暂无菜品生产数据</view>
        </view>

        <view class="card" wx:else>
          <view class="title">菜品清单</view>
          <view class="row-item" wx:for="{{production.items}}" wx:key="dishId">
            <view class="row-main">
              <view class="dish-name">{{item.dishName}}</view>
              <view class="muted small">需做 {{item.needQty}} 份</view>
              <view class="muted small" wx:if="{{item.isOver}}">已超量生产</view>
            </view>
            <view class="row-side">
              <view class="prepared {{item.isDone ? 'done' : ''}}">{{item.preparedQty}} / {{item.needQty}}</view>
              <view class="ops" wx:if="{{canEdit}}">
                <button class="icon-btn" size="mini" catchtap="onAdjustPrepared" data-id="{{item.dishId}}" data-delta="-1" disabled="{{operatingDishId || item.preparedQty<=0}}">-</button>
                <button class="icon-btn plus" size="mini" catchtap="onAdjustPrepared" data-id="{{item.dishId}}" data-delta="1" disabled="{{operatingDishId}}">+</button>
              </view>
            </view>
          </view>
        </view>
      </block>
    </block>
  </view>
</scroll-view>


page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7fb;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 18rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
  color: #111827;
}

.picker {
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
}

.muted {
  color: rgba(0, 0, 0, 0.55);
}

.small {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.warn {
  color: #b42318;
}

.progress-head {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
}

.progress-percent {
  color: #101828;
  font-size: 36rpx;
  font-weight: 800;
}

.progress-track {
  margin-top: 10rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #eaecf0;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #f59e0b 0%, #f97316 100%);
}

.row-item {
  display: flex;
  gap: 14rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: 16rpx 0;
}

.row-item:first-of-type {
  border-top: none;
  padding-top: 4rpx;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.dish-name {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.row-side {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.prepared {
  color: #111827;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.prepared.done {
  color: #027a48;
}

.ops {
  display: flex;
  gap: 8rpx;
}

.icon-btn {
  min-width: 56rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 12rpx;
  padding: 0;
  font-size: 28rpx;
  color: #111827;
  background: #f8fafc;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
}

.icon-btn.plus {
  background: #ecfdf3;
  border-color: rgba(2, 122, 72, 0.18);
  color: #027a48;
}

.icon-btn::after {
  border: none;
}

button[disabled] {
  opacity: 0.45;
}


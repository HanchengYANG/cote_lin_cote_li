page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7fb;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.page {
  padding: 24rpx;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 18rpx;
}
.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.input {
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
}
.textarea {
  min-height: 220rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 16rpx;
}
.muted {
  color: rgba(0, 0, 0, 0.55);
}
.small {
  font-size: 24rpx;
  margin-top: 10rpx;
}
.btn {
  background: #111;
  color: #fff;
  border-radius: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.btn[disabled] {
  opacity: 0.4;
}
.btn.ghost {
  background: transparent;
  color: #111;
  border: 1rpx solid rgba(0, 0, 0, 0.18);
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 16rpx;
}

.img-row {
  width: 100%;
  height: 390rpx;
  white-space: nowrap;
}
.img-list {
  display: inline-flex;
  align-items: flex-start;
  padding-bottom: 6rpx;
}
.img-item {
  width: 300rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.img {
  width: 300rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.06);
}
.img-ops {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-top: 10rpx;
}
.op {
  display: block;
  box-sizing: border-box;
  background: transparent;
  border: 1rpx solid rgba(0, 0, 0, 0.18);
  border-radius: 14rpx;
  width: 100%;
  height: 52rpx;
  line-height: 52rpx;
  margin-top: 8rpx;
  padding: 0 10rpx;
  font-size: 22rpx;
  white-space: nowrap;
  text-align: center;
}
.op:first-child {
  margin-top: 0;
}
.op.danger {
  border-color: rgba(176, 0, 32, 0.35);
  color: #b00020;
}
.img-add {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-start;
}

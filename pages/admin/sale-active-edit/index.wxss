page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7fb;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.page {
  padding: 24rpx;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 18rpx;
}
.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.muted {
  color: rgba(0, 0, 0, 0.55);
}
.small {
  font-size: 24rpx;
}
.picker {
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
  margin-top: 12rpx;
}
.picker.compact {
  margin-top: 0;
  padding: 14rpx 14rpx;
  width: 100%;
  min-height: 76rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}
.textarea {
  min-height: 140rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 16rpx;
}
.dish-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}
.dish-row:first-of-type {
  border-top: none;
}
.dish-main {
  flex: 1;
  min-width: 0;
}
.dish-name {
  font-size: 30rpx;
  font-weight: 600;
}
.qty-input {
  width: 150rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 12rpx;
  padding: 12rpx;
  text-align: right;
}
.qty-input.full {
  width: auto;
  margin-top: 12rpx;
}
.add-dish-row {
  display: flex;
  align-items: stretch;
  margin-top: 12rpx;
}
.add-dish-picker-wrap {
  flex: 1 1 0;
  min-width: 0;
}
.qty-input.add-dish-qty {
  width: 160rpx;
  min-width: 160rpx;
  margin-left: 12rpx;
  box-sizing: border-box;
  min-height: 76rpx;
  padding: 0 12rpx;
  line-height: 76rpx;
  text-align: center;
}
.mini-btn.ghost {
  background: transparent;
  color: #111;
  border: 1rpx solid rgba(0, 0, 0, 0.18);
}
.btn {
  background: #111;
  color: #fff;
  border-radius: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 14rpx;
}
.btn.block {
  width: 100%;
  box-sizing: border-box;
}
.btn.ghost {
  background: transparent;
  color: #111;
  border: 1rpx solid rgba(0, 0, 0, 0.18);
}
.btn[disabled] {
  opacity: 0.4;
}

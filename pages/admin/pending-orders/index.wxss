page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7fb;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 18rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.muted {
  color: rgba(0, 0, 0, 0.55);
}

.small {
  font-size: 24rpx;
}

.strong {
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
}

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.mid {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tag {
  font-size: 24rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.tag.pending {
  background: rgba(255, 186, 8, 0.2);
  color: #7a4f00;
}


<navigation-bar title="订单详情" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<sync-guard ready="{{isReady}}" error="{{syncError}}" bindretry="onSyncRetry"></sync-guard>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="card" wx:if="{{order}}">
      <view class="title">客人信息</view>
      <view class="muted small">昵称：{{order.customerNickname || '未设置昵称'}}</view>
      <view class="muted small">OpenID：{{order.customerOpenId || '-'}}</view>
    </view>

    <view class="card" wx:if="{{order}}">
      <view class="title">标签导出</view>
      <view class="muted small">导出当前订单标签</view>
      <view class="btn-row">
        <button class="btn ghost" loading="{{exportingLabelPdf}}" disabled="{{exportingLabelPdf}}" bindtap="onExportLabelPdf">
          导出本单标签 PDF
        </button>
      </view>
    </view>

    <view class="card" wx:if="{{order}}">
      <view class="title">交货方式设置</view>
      <radio-group bindchange="onFulfillmentChange">
        <label class="radio">
          <radio value="delivery" checked="{{fulfillmentTypeDraft==='delivery'}}" />
          <text>配送</text>
        </label>
        <label class="radio">
          <radio value="pickup" checked="{{fulfillmentTypeDraft==='pickup'}}" />
          <text>自取</text>
        </label>
      </radio-group>
      <view class="field" wx:if="{{fulfillmentTypeDraft==='pickup'}}">
        <view class="label">自取联系电话</view>
        <input class="input" type="number" value="{{phoneDraft}}" placeholder="电话（10位，如 06 12 34 56 78）" bindinput="onPhoneInput" bindblur="onPhoneBlur" />
      </view>
      <view class="field" wx:if="{{fulfillmentTypeDraft==='delivery'}}">
        <view class="label">配送地址</view>
        <radio-group class="mode-group" bindchange="onAddressModeChange">
          <label class="radio">
            <radio value="saved" checked="{{addressMode==='saved'}}" />
            <text>客户已存地址</text>
          </label>
          <label class="radio">
            <radio value="manual" checked="{{addressMode==='manual'}}" />
            <text>手动填写</text>
          </label>
        </radio-group>

        <view wx:if="{{addressMode==='saved'}}">
          <picker mode="selector" range="{{customerAddresses}}" range-key="label" value="{{selectedAddressIndex}}" bindchange="onPickSavedAddress">
            <view class="picker" wx:if="{{customerAddresses.length}}">已选：{{customerAddresses[selectedAddressIndex].label || customerAddresses[selectedAddressIndex].line1}}</view>
            <view class="picker" wx:else>客户暂无已存地址，请切换手动填写</view>
          </picker>
          <view class="muted small" wx:if="{{customerAddresses.length}}">
            {{customerAddresses[selectedAddressIndex].line1}} {{customerAddresses[selectedAddressIndex].line2}} {{customerAddresses[selectedAddressIndex].postalCode}} {{customerAddresses[selectedAddressIndex].city}} {{customerAddresses[selectedAddressIndex].country}}
          </view>
          <input class="input" type="number" value="{{phoneDraft}}" placeholder="配送联系电话（必填，10位）" bindinput="onPhoneInput" bindblur="onPhoneBlur" />
        </view>

        <view wx:if="{{addressMode==='manual'}}">
          <input class="input" data-k="label" value="{{manualAddress.label}}" placeholder="地址标签（可选）" bindinput="onManualAddressInput" />
          <input
            class="input"
            data-k="line1"
            value="{{manualAddress.line1}}"
            placeholder="街道地址 line1（支持补全）"
            bindinput="onManualAddressLine1Input"
            bindfocus="onManualAddressLine1Focus"
            bindblur="onManualAddressLine1Blur"
          />
          <view class="suggest-list" wx:if="{{manualAddressSuggestions.length>0}}">
            <view
              class="suggest-item"
              wx:for="{{manualAddressSuggestions}}"
              wx:key="index"
              data-i="{{index}}"
              bindtouchstart="onManualAddressSuggestionTouchStart"
              bindtap="pickManualAddressSuggestion"
            >
              <view class="suggest-main">{{item.label}}</view>
              <view class="suggest-sub">{{item.postalCode}} {{item.city}}</view>
            </view>
          </view>
          <input class="input" data-k="line2" value="{{manualAddress.line2}}" placeholder="补充信息 line2（可选）" bindinput="onManualAddressInput" />
          <view class="row2">
            <input class="input half" data-k="postalCode" value="{{manualAddress.postalCode}}" placeholder="邮编" bindinput="onManualAddressInput" />
            <input class="input half" data-k="city" value="{{manualAddress.city}}" placeholder="城市" bindinput="onManualAddressInput" />
          </view>
          <input class="input" type="number" value="{{phoneDraft}}" placeholder="配送联系电话（必填，10位）" bindinput="onPhoneInput" bindblur="onPhoneBlur" />
        </view>
      </view>
    </view>

    <view class="card slot-card" wx:if="{{order && fulfillmentTypeDraft==='delivery'}}">
      <view class="title">配送时间段</view>
      <view class="slot-grid">
        <view class="slot-cell">
          <view class="label">日期</view>
          <picker mode="date" value="{{slotDate}}" bindchange="onPickDate">
            <view class="picker">{{slotDate || '请选择日期'}}</view>
          </picker>
        </view>
        <view class="slot-cell">
          <view class="label">开始</view>
          <picker mode="time" value="{{slotStart}}" bindchange="onPickStart">
            <view class="picker">{{slotStart || '请选择时间'}}</view>
          </picker>
        </view>
        <view class="slot-cell">
          <view class="label">结束</view>
          <picker mode="time" value="{{slotEnd}}" bindchange="onPickEnd">
            <view class="picker">{{slotEnd || '请选择时间'}}</view>
          </picker>
        </view>
      </view>
      <view class="slot-preview">当前时间段：{{deliverySlotInput || '未设置'}}</view>
      <view class="muted small">修改后将在“保存修改”时生效</view>
    </view>

    <view class="card" wx:if="{{isPendingReview}}">
      <view class="title">待确认操作</view>
      <view class="muted small">立即确认会立刻纳入本次备菜与履约；如需作废请使用下方“取消整单”。</view>
      <view class="btn-row">
        <button class="btn ghost" loading="{{approving}}" disabled="{{approving}}" bindtap="onApproveNow">立即确认</button>
      </view>
    </view>

    <view class="card" wx:if="{{order}}">
      <view class="title">付款与履约状态</view>
      <view class="field">
        <view class="label">付款方式</view>
        <picker
          mode="selector"
          range="{{paymentMethodOptions}}"
          range-key="label"
          value="{{paymentMethodIndex}}"
          bindchange="onPickPaymentMethod"
          disabled="{{!canEditPaymentMethod}}"
        >
          <view class="picker {{canEditPaymentMethod ? '' : 'picker-disabled'}}">付款方式：{{paymentMethodLabel}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">收款状态</view>
        <picker
          mode="selector"
          range="{{paidStatusOptions}}"
          range-key="label"
          value="{{paidStatusIndex}}"
          bindchange="onPickPaidStatus"
          disabled="{{!canEditProgressStatus}}"
        >
          <view class="picker {{canEditProgressStatus ? '' : 'picker-disabled'}}">收款状态：{{paidStatusOptions[paidStatusIndex].label}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">交货状态</view>
        <picker
          mode="selector"
          range="{{handoffStatusOptions}}"
          range-key="label"
          value="{{handoffStatusIndex}}"
          bindchange="onPickHandoffStatus"
          disabled="{{!canEditProgressStatus}}"
        >
          <view class="picker {{canEditProgressStatus ? '' : 'picker-disabled'}}">交货状态：{{handoffStatusOptions[handoffStatusIndex].label}}</view>
        </picker>
      </view>
      <view class="muted small" wx:if="{{!canEditProgressStatus}}">仅有效订单可修改收款状态与交货状态。</view>
    </view>

    <view class="card" wx:if="{{order}}">
      <view class="title">备注</view>
      <block wx:if="{{canEditItems}}">
        <textarea
          class="textarea"
          maxlength="300"
          placeholder="可选：口味、门禁、付款说明等"
          value="{{remarkDraft}}"
          bindinput="onRemarkInput"
        />
        <view class="muted small">修改后点击“保存修改”生效</view>
      </block>
      <view class="muted small" wx:else>{{remarkDraft || '无备注'}}</view>
    </view>

    <order-editor
      order="{{order}}"
      editable-items="{{editableItems}}"
      editable-totals="{{editableTotals}}"
      can-edit-items="{{canEditItems}}"
      can-cancel-order="{{canCancelOrder}}"
      saving="{{saving}}"
      cancelling="{{cancelling}}"
      can-add-items="{{canEditItems}}"
      show-payment="{{false}}"
      show-payment-status="{{true}}"
      show-fulfillment="{{false}}"
      show-contact="{{false}}"
      show-remark="{{false}}"
      edit-hint="店主可直接修改本单菜品数量；如需整单作废请点“取消整单”。"
      lock-hint="订单已取消，不可编辑。"
      bindadditem="onOpenAddDishPicker"
      bindqtychange="onQtyChange"
      bindremoveitem="onRemoveItem"
      bindsave="onSaveItems"
      bindcancelorder="onCancelOrder"
    />

    <view class="sheet-mask" wx:if="{{showDishPicker}}" bindtap="onCloseDishPicker">
      <view class="sheet-card" catchtap="noop">
        <view class="sheet-head">
          <view class="sheet-title">新增菜品</view>
          <view class="sheet-close" bindtap="onCloseDishPicker">关闭</view>
        </view>
        <view class="muted small">选择一个菜品加入当前订单（已存在则数量 +1）</view>
        <scroll-view class="sheet-list" scroll-y>
          <view class="sheet-empty muted" wx:if="{{loadingDishPicker}}">加载中...</view>
          <view class="sheet-empty muted" wx:elif="{{!allDishesForPick.length}}">暂无菜品</view>
          <view
            class="sheet-item"
            wx:for="{{allDishesForPick}}"
            wx:key="_id"
            data-id="{{item._id}}"
            bindtap="onPickDishToAdd"
          >
            <view class="sheet-item-main">
              <view class="sheet-item-name">{{item.name}}</view>
              <view class="sheet-item-meta">
                <text wx:if="{{!item.isActive}}" class="sheet-tag muted-tag">已下架</text>
                <text>ID: {{item._id}}</text>
              </view>
            </view>
            <view class="sheet-price">€{{item.priceEuro}}</view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>
</scroll-view>

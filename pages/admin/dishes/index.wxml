<navigation-bar title="菜品库" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<sync-guard ready="{{isReady}}" error="{{syncError}}" bindretry="onSyncRetry"></sync-guard>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="row">
      <button class="btn" bindtap="add">新增菜品</button>
    </view>

    <view class="list">
      <view class="item" wx:for="{{dishes}}" wx:key="_id">
        <view class="left" bindtap="edit" data-id="{{item._id}}">
          <view class="left-row">
            <image wx:if="{{item.thumb}}" class="thumb" mode="aspectFill" src="{{item.thumb}}" />
            <view class="left-text">
              <view class="name">{{item.name}}</view>
              <view class="muted small">€{{item.priceEuro}}</view>
            </view>
          </view>
        </view>
        <view class="right">
          <switch checked="{{item.isActive}}" bindchange="toggle" data-id="{{item._id}}" />
        </view>
      </view>
    </view>
  </view>
</scroll-view>

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7fb;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.page {
  padding: 24rpx;
}
.row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 18rpx;
}
.btn {
  background: #111;
  color: #fff;
  border-radius: 18rpx;
  height: 78rpx;
  line-height: 78rpx;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.item {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.left-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.thumb {
  width: 84rpx;
  height: 84rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.06);
  flex: none;
}
.left-text {
  display: flex;
  flex-direction: column;
}
.name {
  font-weight: 700;
  font-size: 30rpx;
}
.muted {
  color: rgba(0, 0, 0, 0.55);
}
.small {
  font-size: 24rpx;
  margin-top: 6rpx;
}

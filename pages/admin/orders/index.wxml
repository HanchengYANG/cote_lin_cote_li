<navigation-bar title="订单管理" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="card">
      <view class="title">筛选</view>
      <picker mode="selector" range="{{saleOptions}}" range-key="label" value="{{saleIndex}}" bindchange="onPickSale">
        <view class="picker">开单：{{saleLabel}}</view>
      </picker>
      <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onPickType">
        <view class="picker">类型：{{typeLabel}}</view>
      </picker>
      <button class="btn ghost" size="mini" bindtap="reload">刷新</button>
    </view>

    <view class="card" wx:if="{{orders.length===0 && !loading}}">
      <view class="muted">暂无订单</view>
    </view>

    <view class="list" wx:else>
      <view class="item" wx:for="{{orders}}" wx:key="_id" bindtap="goDetail" data-id="{{item._id}}">
        <view class="top">
          <view class="tag {{item.statusClass}}">{{item.statusText}}</view>
          <view class="muted small">{{item.createdAtText}}</view>
        </view>
        <view class="mid">
          <view class="strong">{{item.fulfillmentText}}</view>
          <view class="muted small">电话：{{item.contact.phone}}</view>
          <view class="muted small" wx:if="{{item.deliveryTimeSlotLabelSnapshot}}">时间段：{{item.deliveryTimeSlotLabelSnapshot}}</view>
        </view>
        <view class="muted small">€{{item.totals.amountEuro}}（{{item.totals.qty}}件）</view>
      </view>
    </view>
  </view>
</scroll-view>

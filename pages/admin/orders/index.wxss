page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7fb;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.page {
  padding: 24rpx;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 18rpx;
}
.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.picker {
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
  margin-top: 12rpx;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.item {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
}
.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.tag {
  font-size: 24rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.06);
}
.tag.ok {
  background: rgba(0, 0, 0, 0.08);
}
.tag.done {
  background: rgba(22, 101, 52, 0.14);
  color: #166534;
}
.tag.delivered {
  background: rgba(15, 118, 110, 0.14);
  color: #0f766e;
}
.tag.paid {
  background: rgba(29, 78, 216, 0.12);
  color: #1d4ed8;
}
.tag.cancel {
  background: rgba(255, 0, 0, 0.10);
  color: #b00020;
}
.tag.pending {
  background: rgba(255, 186, 8, 0.2);
  color: #7a4f00;
}
.tag.reject {
  background: rgba(107, 114, 128, 0.14);
  color: #4b5563;
}
.muted {
  color: rgba(0, 0, 0, 0.55);
}
.small {
  font-size: 24rpx;
}
.mid {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.45);
}

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7fb;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 18rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.muted {
  color: rgba(0, 0, 0, 0.55);
}

.small {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.addr {
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.addr:last-child {
  border-bottom: none;
}

.addr-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.strong {
  font-size: 28rpx;
  font-weight: 600;
  color: #111;
}

.order {
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.order:last-child {
  border-bottom: none;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.06);
}

.tag.ok {
  background: rgba(0, 0, 0, 0.08);
}

.tag.cancel {
  background: rgba(255, 0, 0, 0.1);
  color: #b00020;
}

.tag.pending {
  background: rgba(255, 186, 8, 0.2);
  color: #7a4f00;
}

<navigation-bar title="交付准备" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<sync-guard ready="{{isReady}}" error="{{syncError}}" bindretry="onSyncRetry"></sync-guard>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="card" wx:if="{{loadPhase!=='ready'}}">
      <view class="muted">载入中...</view>
    </view>

    <block wx:else>
      <view class="card">
        <view class="title">选择开单</view>
        <picker mode="selector" range="{{saleOptions}}" range-key="label" value="{{saleIndex}}" bindchange="onPickSale">
          <view class="picker">开单：{{saleLabel}}</view>
        </picker>
        <view class="muted small" wx:if="{{loadingSales || loadingPrep}}">加载中...</view>
      </view>

      <view class="card" wx:if="{{!sale}}">
        <view class="muted">暂无可交付开单</view>
      </view>

      <block wx:else>
        <view class="card">
          <view class="title">状态</view>
          <view class="muted small">开单状态：{{sale.statusText || sale.status}}</view>
          <view class="muted small" wx:if="{{sale.deliveryTimeSlotLabel}}">时间段：{{sale.deliveryTimeSlotLabel}}</view>
          <view class="muted small warn" wx:if="{{!canEdit}}">该开单已完成，仅可查看排序结果</view>
          <view class="muted small warn" wx:if="{{canEdit && sale.status==='FULFILLING'}}">配送进行中，调整排序会影响后续执行顺序</view>
          <view class="muted small" wx:if="{{deliveryAppendedHint}}">{{deliveryAppendedHint}}</view>
        </view>

        <view class="card" wx:if="{{loadingPrep}}">
          <view class="muted">加载订单中...</view>
        </view>

        <view class="card" wx:elif="{{deliveryOrders.length===0 && pickupOrders.length===0}}">
          <view class="title">订单清单</view>
          <view class="muted">暂无有效订单</view>
        </view>

        <block wx:else>
          <view class="card">
            <view class="section-head" bindtap="toggleDeliveryCollapsed">
              <view>
                <view class="title no-margin">配送单（{{deliveryOrders.length}}）</view>
                <view class="muted small section-note">仅配送单参与排序</view>
              </view>
              <view class="fold-btn">{{deliveryCollapsed ? '展开' : '收起'}}</view>
            </view>
            <block wx:if="{{!deliveryCollapsed}}">
              <view class="sale-stats-empty muted small" wx:if="{{deliveryOrders.length===0}}">暂无配送单（纯自取开单也可点“备单完成”进入配送中）</view>
              <block wx:else>
                <view class="order-row" wx:for="{{deliveryOrders}}" wx:key="_id">
                  <view class="order-main">
                    <view class="order-top">
                      <text class="name">{{item.customerNameText}}</text>
                      <text class="amount">€{{item.amountEuro}}</text>
                    </view>
                    <view class="meta-line">
                      <text class="tag delivery">配送</text>
                      <text class="address">{{item.addressDisplay}}</text>
                    </view>
                  </view>
                  <view class="ops" wx:if="{{canEdit}}">
                    <button class="mini ghost icon" size="mini" data-idx="{{index}}" bindtap="onMoveUp" disabled="{{index===0 || saving || markingPrepDone}}">⬆️</button>
                    <button class="mini ghost icon" size="mini" data-idx="{{index}}" bindtap="onMoveDown" disabled="{{index===deliveryOrders.length-1 || saving || markingPrepDone}}">⬇️</button>
                  </view>
                </view>
              </block>
              <view class="muted small" wx:if="{{canEdit && saving}}">排序保存中...</view>
            </block>
          </view>

          <view class="card">
            <view class="section-head" bindtap="togglePickupCollapsed">
              <view>
                <view class="title no-margin">自取单（{{pickupOrders.length}}）</view>
                <view class="muted small section-note">仅展示，不参与配送排序</view>
              </view>
              <view class="fold-btn">{{pickupCollapsed ? '展开' : '收起'}}</view>
            </view>
            <block wx:if="{{!pickupCollapsed}}">
              <view class="sale-stats-empty muted small" wx:if="{{pickupOrders.length===0}}">暂无自取单</view>
              <block wx:else>
                <view class="order-row" wx:for="{{pickupOrders}}" wx:key="_id">
                  <view class="order-main">
                    <view class="order-top">
                      <text class="name">{{item.customerNameText}}</text>
                      <text class="amount">€{{item.amountEuro}}</text>
                    </view>
                    <view class="meta-line">
                      <text class="tag pickup">自取</text>
                      <text class="address">{{item.addressDisplay}}</text>
                    </view>
                    <view class="meta-line">
                      <text class="address">电话：{{item.phoneText}}</text>
                    </view>
                  </view>
                </view>
              </block>
            </block>
          </view>
        </block>

        <view class="page-actions" wx:if="{{sale && canEdit && sale.status==='CLOSED'}}">
          <button class="btn primary" loading="{{markingPrepDone}}" disabled="{{saving || markingPrepDone || loadingPrep}}" bindtap="onMarkPrepDone">✅ 备单完成</button>
        </view>
      </block>
    </block>
  </view>
</scroll-view>

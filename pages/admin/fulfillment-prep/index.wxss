page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7fb;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 18rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
  color: #111827;
}

.picker {
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
}

.muted {
  color: rgba(0, 0, 0, 0.55);
}

.small {
  font-size: 24rpx;
  margin-top: 10rpx;
}

.warn {
  color: #b42318;
}

.sale-stats-empty {
  padding: 14rpx;
  background: #f8fafc;
  border-radius: 14rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.title.no-margin {
  margin-bottom: 0;
}

.section-note {
  margin-top: 4rpx;
}

.fold-btn {
  flex: none;
  color: #475467;
  font-size: 24rpx;
  line-height: 1.2;
}

.order-row {
  display: flex;
  gap: 14rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: 16rpx 0;
}

.order-row:first-of-type {
  border-top: none;
  padding-top: 4rpx;
}

.order-main {
  flex: 1;
  min-width: 0;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
}

.name {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.amount {
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
  white-space: nowrap;
}

.meta-line {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tag {
  flex: none;
  border-radius: 999rpx;
  padding: 4rpx 10rpx;
  font-size: 22rpx;
  line-height: 1.1;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  color: #334155;
  background: #f8fafc;
}

.tag.delivery {
  color: #175cd3;
  background: #eff6ff;
  border-color: rgba(23, 92, 211, 0.16);
}

.tag.pickup {
  color: #027a48;
  background: #ecfdf3;
  border-color: rgba(2, 122, 72, 0.16);
}

.address {
  color: rgba(0, 0, 0, 0.66);
  font-size: 24rpx;
  line-height: 1.35;
  min-width: 0;
  flex: 1;
  word-break: break-word;
}

.ops {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mini {
  min-width: 116rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 12rpx;
  padding: 0 14rpx;
  font-size: 22rpx;
}

.mini::after {
  border: none;
}

.mini.ghost {
  background: #f8fafc;
  color: #111827;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
}

.btn {
  margin-top: 14rpx;
  background: #111;
  color: #fff;
  border-radius: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-weight: 700;
}

.btn::after {
  border: none;
}

.btn.ghost {
  background: #f8fafc;
  color: #111827;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
}

button[disabled] {
  opacity: 0.45;
}

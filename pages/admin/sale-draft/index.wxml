<navigation-bar title="开单草稿" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="card" wx:if="{{!sale}}">
      <view class="muted small">加载中...</view>
    </view>

    <view wx:else>
      <view class="card warn" wx:if="{{openDisabled}}">
        <view class="title">提示</view>
        <view class="muted small">当前已有开单中开单，必须先“截单”后才能再开单。</view>
        <button class="btn ghost" size="mini" bindtap="goAdminHome">去截单</button>
      </view>

      <view class="card">
        <view class="title">配送时间段（必填，仅一个）</view>
        <picker mode="date" value="{{slotDate}}" bindchange="onPickDate">
          <view class="picker">日期：{{slotDate || '请选择'}}</view>
        </picker>
        <picker mode="time" value="{{slotStart}}" bindchange="onPickStart">
          <view class="picker">开始：{{slotStart || '请选择'}}</view>
        </picker>
        <picker mode="time" value="{{slotEnd}}" bindchange="onPickEnd">
          <view class="picker">结束：{{slotEnd || '请选择'}}</view>
        </picker>
        <view class="muted small">展示文案：{{slotLabel}}</view>
      </view>

      <view class="card">
        <view class="title">说明文案（可选）</view>
        <textarea class="textarea" placeholder="展示在菜单页顶部" value="{{sale.note}}" bindinput="onNote"></textarea>
      </view>

      <view class="card">
        <view class="title">本次售卖菜品与总量</view>
        <view class="muted small" wx:if="{{dishes.length===0}}">请先到菜品库新增菜品</view>
        <checkbox-group bindchange="onDishSelect">
          <view class="check" wx:for="{{dishes}}" wx:key="_id">
            <checkbox value="{{item._id}}" checked="{{item.selected}}" />
            <view class="check-main">
              <text>{{item.name}} €{{item.priceEuro}}</text>
              <text class="muted small" wx:if="{{!item.isActive}}">（已下架）</text>
            </view>
            <input
              wx:if="{{item.selected}}"
              class="qty-input"
              type="number"
              placeholder="总量"
              value="{{item.limitQtyInput}}"
              data-id="{{item._id}}"
              bindinput="onLimitInput"
            />
          </view>
        </checkbox-group>
        <view class="muted small">说明：每个已选菜都必须填写本次开单总量（非负整数）。</view>
      </view>

      <view class="card">
        <view class="title">延后确认订单（可选）</view>
        <view class="muted small" wx:if="{{pendingOrders.length===0}}">当前没有待确认订单。</view>
        <checkbox-group bindchange="onPendingSelect" wx:else>
          <label class="pending-item" wx:for="{{pendingOrders}}" wx:key="_id">
            <checkbox value="{{item._id}}" checked="{{item.checked}}" />
            <view class="pending-main">
              <view class="pending-title">{{item._id}}</view>
              <view class="muted small">{{item.summary}}</view>
              <view class="muted small" wx:if="{{item.address && item.address.city}}">Ville：{{item.address.city}}</view>
            </view>
          </label>
        </checkbox-group>
        <view class="muted small">勾选后将在本次“开单”时自动确认，并占用本次库存。</view>
      </view>

      <button class="btn" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存草稿</button>
      <button class="btn ghost" loading="{{opening}}" disabled="{{opening || openDisabled}}" bindtap="openSale">开单</button>
    </view>
  </view>
</scroll-view>

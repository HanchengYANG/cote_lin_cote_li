<navigation-bar title="手动录单" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<sync-guard ready="{{isReady}}" error="{{syncError}}" bindretry="onSyncRetry"></sync-guard>
<scroll-view class="scrollarea" scroll-y type="list" refresher-enabled="{{true}}" refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onPullDownRefresh">
  <view class="page">
    <view class="card" wx:if="{{loadPhase!=='ready' && loading}}">
      <view class="muted">加载中...</view>
    </view>

    <view class="card">
      <view class="title">当前开单</view>
      <block wx:if="{{sale}}">
        <view class="row">
          <view class="label">状态</view>
          <view class="value {{saleOpen ? 'ok' : 'warn'}}">{{sale.status}}</view>
        </view>
        <view class="muted small">开单ID：{{sale._id}}</view>
        <view class="muted small">配送时间段：{{sale.deliveryTimeSlotLabel || '未设置'}}</view>
      </block>
      <view class="warn-text" wx:else>当前没有开单中的 sale，暂不可手动录单。</view>
      <view class="warn-text small" wx:if="{{sale && !saleOpen}}">当前仅 OPEN 状态允许手动录单。</view>
    </view>

    <view class="card">
      <view class="title">客户</view>
      <picker mode="selector" range="{{customerActionOptions}}" range-key="label" value="{{customerActionIndex}}" bindchange="onCustomerActionPick">
        <view class="picker-line">
          <view class="label">方式</view>
          <view class="value">{{customerActionOptions[customerActionIndex].label}}</view>
        </view>
      </picker>

      <block wx:if="{{customerAction==='select_existing'}}">
        <input class="input" placeholder="搜索昵称 / 电话 / ID（本地筛选近期客户）" value="{{customerQuery}}" bindinput="onCustomerQueryInput" />
        <view class="list muted small" wx:if="{{filteredCustomers.length===0}}">没有匹配客户</view>
        <view class="customer-list" wx:else>
          <view
            class="customer-item {{item.customerOpenId===selectedCustomerOpenId ? 'selected' : ''}}"
            wx:for="{{filteredCustomers}}"
            wx:key="customerOpenId"
            data-id="{{item.customerOpenId}}"
            bindtap="pickCustomer"
          >
            <view class="row top">
              <view class="strong">{{item.nicknameText}}</view>
              <view class="badge" wx:if="{{item.sourceBadgeText}}">{{item.sourceBadgeText}}</view>
            </view>
            <view class="muted small">电话：{{item.defaultPhone || '-'}}</view>
            <view class="muted small">地址数：{{item.addressCount}}</view>
          </view>
        </view>

        <view class="sub-card" wx:if="{{selectedCustomer}}">
          <view class="row">
            <view class="label">已选客户</view>
            <view class="value">{{selectedCustomer.nicknameText}}</view>
          </view>
          <view class="muted small" wx:if="{{selectedCustomer.sourceBadgeText}}">{{selectedCustomer.sourceBadgeText}}</view>
          <view class="muted small">客户ID：{{selectedCustomer.customerOpenId}}</view>
          <view class="muted small">默认电话：{{selectedCustomer.defaultPhone || '-'}}</view>
        </view>
      </block>

      <block wx:else>
        <input class="input" placeholder="店主代录客户昵称（必填）" value="{{newManualCustomerNickname}}" bindinput="onNewManualNicknameInput" />
        <input class="input" placeholder="客户电话（可选，建议填）" value="{{newManualCustomerProfilePhone}}" bindinput="onNewManualProfilePhoneInput" />
        <view class="muted small">创建成功后会在“客人管理”中显示为“店主代录”客户。</view>
      </block>
    </view>

    <view class="card">
      <view class="title">配送信息</view>
      <picker mode="selector" range="{{fulfillmentOptions}}" range-key="label" value="{{fulfillmentIndex}}" bindchange="onFulfillmentPick">
        <view class="picker-line">
          <view class="label">交货方式</view>
          <view class="value">{{fulfillmentOptions[fulfillmentIndex].label}}</view>
        </view>
      </picker>

      <block wx:if="{{fulfillmentTypeDraft==='delivery'}}">
        <view class="muted small">配送时间段：{{(sale && sale.deliveryTimeSlotLabel) || '未设置'}}</view>

        <block wx:if="{{customerAction==='select_existing'}}">
          <picker mode="selector" range="{{addressModeOptions}}" range-key="label" value="{{addressModeIndex}}" bindchange="onAddressModePick">
            <view class="picker-line">
              <view class="label">地址来源</view>
              <view class="value">{{addressModeOptions[addressModeIndex].label}}</view>
            </view>
          </picker>

          <block wx:if="{{addressMode==='saved'}}">
            <block wx:if="{{customerAddresses.length>0}}">
              <picker mode="selector" range="{{customerAddresses}}" range-key="title" value="{{selectedAddressIndex}}" bindchange="onPickSavedAddress">
                <view class="picker-line">
                  <view class="label">客户地址</view>
                  <view class="value">{{customerAddresses[selectedAddressIndex].title}}</view>
                </view>
              </picker>
              <view class="sub-card">
                <view class="muted small">{{customerAddresses[selectedAddressIndex].detail}}</view>
                <view class="muted small">电话：{{customerAddresses[selectedAddressIndex].phoneText || '-'}}</view>
              </view>
            </block>
            <view class="warn-text small" wx:else>该客户暂无保存地址，请切换为手动地址。</view>
          </block>
        </block>

        <block wx:if="{{customerAction==='create_manual' || addressMode==='manual' || customerAddresses.length===0}}">
          <view class="sub-title">配送地址（手动填写）</view>
          <input class="input" placeholder="地址标签（可选，如家/公司）" data-key="label" value="{{manualAddress.label}}" bindinput="onManualAddressInput" />
          <input
            class="input"
            placeholder="地址行 1（必填，支持补全）"
            data-key="line1"
            value="{{manualAddress.line1}}"
            bindinput="onManualAddressLine1Input"
            bindfocus="onManualAddressLine1Focus"
            bindblur="onManualAddressLine1Blur"
          />
          <view class="suggest-list" wx:if="{{manualAddressSuggestions.length>0}}">
            <view
              class="suggest-item"
              wx:for="{{manualAddressSuggestions}}"
              wx:key="index"
              data-i="{{index}}"
              bindtouchstart="onManualAddressSuggestionTouchStart"
              bindtap="pickManualAddressSuggestion"
            >
              <view class="suggest-main">{{item.label}}</view>
              <view class="suggest-sub">{{item.postalCode}} {{item.city}}</view>
            </view>
          </view>
          <input class="input" placeholder="地址行 2（可选）" data-key="line2" value="{{manualAddress.line2}}" bindinput="onManualAddressInput" />
          <view class="row gap">
            <input class="input half" placeholder="邮编（5位）" data-key="postalCode" value="{{manualAddress.postalCode}}" bindinput="onManualAddressInput" />
            <input class="input half" placeholder="城市" data-key="city" value="{{manualAddress.city}}" bindinput="onManualAddressInput" />
          </view>
          <input class="input" placeholder="配送联系电话（必填）" data-key="phone" value="{{manualAddress.phone}}" bindinput="onManualAddressInput" />
          <view class="muted small" wx:if="{{customerAction==='create_manual'}}">新建店主代录客户时，此配送地址会保存为客户默认地址。</view>
        </block>
      </block>

      <block wx:elif="{{fulfillmentTypeDraft==='pickup'}}">
        <input class="input" placeholder="自取联系电话（必填）" value="{{pickupPhoneDraft}}" bindinput="onPickupPhoneInput" />
      </block>
    </view>

    <view class="card">
      <view class="title">菜品与数量</view>
      <view class="muted small">店主手动录单不受库存不足阻断；若超出剩余库存会自动扩容并计入统计。</view>
      <view class="sub-card">
        <view class="sub-title no-gap">新增菜品到订单</view>
        <block wx:if="{{addDishOptions.length>0}}">
          <view class="add-dish-row">
            <view class="add-dish-picker-wrap">
              <picker mode="selector" range="{{addDishOptions}}" range-key="label" value="{{addDishIndex}}" bindchange="onAddDishPick">
                <view class="picker-box">{{addDishOptions[addDishIndex].label}}</view>
              </picker>
            </view>
          </view>
          <button class="add-btn" bindtap="addDish">➕ 新增到订单</button>
          <view class="muted small">未在本期开单的菜也可新增，提交时会自动加入并扩容。</view>
        </block>
        <view class="muted small" wx:else>没有可新增的可用菜品。</view>
      </view>

      <view class="sub-card">
        <view class="row">
          <view class="label">已选总数</view>
          <view class="value">{{editableTotals.qty}}</view>
        </view>
        <view class="row">
          <view class="label">总金额</view>
          <view class="value">€{{editableTotals.amountEuro}}</view>
        </view>
        <view class="selected-list" wx:if="{{editableItems.length>0}}">
          <view class="selected-row" wx:for="{{editableItems}}" wx:key="dishId">
            <view class="selected-main">
              <view class="small-strong">{{item.dishName}}</view>
              <view class="muted small">€{{item.unitPriceEuro}} × {{item.qty}}</view>
            </view>
            <view class="selected-side">
              <view class="small-strong">€{{item.lineTotalEuro}}</view>
              <view class="selected-ops">
                <view class="mini-op" data-id="{{item.dishId}}" bindtap="decDish">-</view>
                <view class="mini-op plus" data-id="{{item.dishId}}" bindtap="incDish">+</view>
                <view class="small-link danger-link" data-id="{{item.dishId}}" bindtap="clearDish">🗑️</view>
              </view>
            </view>
          </view>
        </view>
        <view class="muted small" wx:else>暂未选择菜品</view>
      </view>
    </view>

    <view class="card">
      <view class="title">付款与交付状态</view>
      <picker mode="selector" range="{{paymentMethodOptions}}" range-key="label" value="{{paymentMethodIndex}}" bindchange="onPickPaymentMethod">
        <view class="picker-line">
          <view class="label">付款方式</view>
          <view class="value">{{paymentMethodOptions[paymentMethodIndex].label}}</view>
        </view>
      </picker>
      <picker mode="selector" range="{{paidStatusOptions}}" range-key="label" value="{{paidStatusIndex}}" bindchange="onPickPaidStatus">
        <view class="picker-line">
          <view class="label">收款状态</view>
          <view class="value">{{paidStatusOptions[paidStatusIndex].label}}</view>
        </view>
      </picker>
      <picker mode="selector" range="{{handoffStatusOptions}}" range-key="label" value="{{handoffStatusIndex}}" bindchange="onPickHandoffStatus">
        <view class="picker-line">
          <view class="label">交付状态</view>
          <view class="value">{{handoffStatusOptions[handoffStatusIndex].label}}</view>
        </view>
      </picker>
    </view>

    <view class="card">
      <view class="title">备注</view>
      <textarea class="textarea" maxlength="300" placeholder="可选：口味、门禁、付款说明等" value="{{remarkDraft}}" bindinput="onRemarkInput" />
    </view>

    <view class="card">
      <button class="btn primary" loading="{{submitting}}" disabled="{{submitting || !saleOpen}}" bindtap="submit">✅ 创建订单</button>
      <view class="muted small" wx:if="{{!saleOpen}}">需要当前存在 OPEN 状态开单才能创建。</view>
    </view>
  </view>
</scroll-view>

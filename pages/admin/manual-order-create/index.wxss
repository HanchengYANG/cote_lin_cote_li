page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f3f5f8;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 20rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 8rpx 26rpx rgba(15, 23, 42, 0.05);
}

.title {
  color: #101828;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.sub-title {
  color: #344054;
  font-size: 24rpx;
  font-weight: 600;
  margin-top: 12rpx;
  margin-bottom: 8rpx;
}

.sub-title.no-gap {
  margin-top: 0;
}

.muted {
  color: #667085;
}

.small {
  font-size: 22rpx;
  line-height: 1.4;
}

.strong {
  color: #101828;
  font-size: 26rpx;
  font-weight: 700;
}

.small-strong {
  color: #101828;
  font-size: 24rpx;
  font-weight: 600;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.row.top {
  align-items: flex-start;
}

.row.gap {
  gap: 10rpx;
}

.label {
  color: #475467;
  font-size: 24rpx;
}

.value {
  color: #101828;
  font-size: 24rpx;
  font-weight: 600;
}

.value.ok {
  color: #027a48;
}

.value.warn {
  color: #b42318;
}

.picker-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 64rpx;
  padding: 6rpx 0;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.05);
}

.picker-line:last-child {
  border-bottom: none;
}

.input {
  margin-top: 10rpx;
  min-height: 72rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  background: #fff;
  box-sizing: border-box;
  padding: 0 18rpx;
  font-size: 26rpx;
}

.input.half {
  width: calc(50% - 5rpx);
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  box-sizing: border-box;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.warn-text {
  color: #b42318;
  line-height: 1.45;
}

.list {
  margin-top: 10rpx;
}

.customer-list {
  margin-top: 10rpx;
  max-height: 520rpx;
}

.customer-item {
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: #fbfcfe;
  padding: 14rpx;
  margin-bottom: 10rpx;
}

.customer-item.selected {
  border-color: rgba(18, 183, 106, 0.45);
  background: #f0fdf4;
}

.badge {
  flex: none;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #175cd3;
  font-size: 20rpx;
  font-weight: 600;
}

.sub-card {
  margin-top: 12rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  background: #f8fafc;
  padding: 14rpx;
}

.add-dish-row {
  display: flex;
  align-items: stretch;
  gap: 10rpx;
  margin-top: 10rpx;
  margin-bottom: 10rpx;
}

.add-dish-picker-wrap {
  flex: 1 1 0;
  min-width: 0;
}

.picker-box {
  min-height: 72rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  background: #fff;
  box-sizing: border-box;
  padding: 0 16rpx;
  font-size: 24rpx;
  line-height: 1.35;
  display: flex;
  align-items: center;
}

.qty-input {
  width: 120rpx;
  min-width: 120rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  background: #fff;
  box-sizing: border-box;
  padding: 0 12rpx;
  text-align: center;
  font-size: 24rpx;
  min-height: 72rpx;
}

.qty-input.add-dish-qty {
  width: 132rpx;
  min-width: 132rpx;
}

.add-btn {
  width: 100%;
  margin: 0 0 10rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.18);
  background: #fff;
  color: #111827;
  font-size: 24rpx;
}

.suggest-list {
  margin-top: 8rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: #fff;
  overflow: hidden;
}

.suggest-item {
  padding: 14rpx 16rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.05);
}

.suggest-item:first-child {
  border-top: none;
}

.suggest-main {
  color: #101828;
  font-size: 24rpx;
  line-height: 1.35;
}

.suggest-sub {
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.3;
}

.dish-list {
  margin-top: 12rpx;
}

.dish-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(15, 23, 42, 0.05);
}

.dish-row:first-child {
  border-top: none;
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-main .muted {
  word-break: break-word;
}

.qty-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
}

.qty-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #344054;
  background: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.qty-btn.plus {
  color: #027a48;
}

.qty-num {
  min-width: 42rpx;
  text-align: center;
  color: #101828;
  font-size: 24rpx;
  font-weight: 700;
}

.selected-list {
  margin-top: 10rpx;
}

.selected-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding-top: 10rpx;
  margin-top: 10rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.05);
}

.selected-main {
  flex: 1;
  min-width: 0;
}

.selected-side {
  flex: none;
  text-align: right;
}

.selected-ops {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.mini-op {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #344054;
  background: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.mini-op.plus {
  color: #027a48;
}

.small-link {
  color: #175cd3;
  font-size: 22rpx;
}

.btn.primary {
  width: 100%;
  background: #111827;
  color: #fff;
  border-radius: 14rpx;
  font-size: 28rpx;
}

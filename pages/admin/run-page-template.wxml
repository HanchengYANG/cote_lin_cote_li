<sync-guard ready="{{isReady}}" error="{{syncError}}" bindretry="onSyncRetry"></sync-guard>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="card" wx:if="{{loadPhase!=='ready'}}">
      <view class="muted">载入中...</view>
    </view>

    <block wx:else>
      <view class="card">
        <view class="title">选择开单</view>
        <picker mode="selector" range="{{saleOptions}}" range-key="label" value="{{saleIndex}}" bindchange="onPickSale">
          <view class="picker">开单：{{saleLabel}}</view>
        </picker>
        <view class="muted small" wx:if="{{loadingSales || loadingRun}}">加载中...</view>
      </view>

      <view class="card" wx:if="{{!sale}}">
        <view class="muted">{{noSaleText}}</view>
      </view>

      <block wx:else>
        <view class="card">
          <view class="title">{{progressTitle}}</view>
          <view class="muted small">开单状态：{{sale.statusText || sale.status}}</view>
          <view class="muted small" wx:if="{{sale.deliveryTimeSlotLabel}}">时间段：{{sale.deliveryTimeSlotLabel}}</view>
          <view class="muted small" wx:if="{{appendedHint}}">{{appendedHint}}</view>
          <view class="muted small warn" wx:if="{{!canOperate}}">该开单已完成，仅可查看执行结果</view>
          <view class="summary-grid">
            <view class="summary-item">
              <view class="summary-label">{{activeOrderCountLabel}}</view>
              <view class="summary-value">{{summary.totalActiveOrders}}</view>
            </view>
            <view class="summary-item">
              <view class="summary-label">已交付</view>
              <view class="summary-value">{{summary.deliveredOrders}}</view>
            </view>
            <view class="summary-item">
              <view class="summary-label">已收款</view>
              <view class="summary-value">{{summary.paidOrders}}</view>
            </view>
            <view class="summary-item">
              <view class="summary-label">剩余未完成</view>
              <view class="summary-value">{{summary.remainingOrders}}</view>
            </view>
          </view>
        </view>

        <view class="card" wx:if="{{loadingRun}}">
          <view class="muted">加载订单中...</view>
        </view>

        <view class="card" wx:elif="{{pendingOrders.length===0 && deliveredOrders.length===0}}">
          <view class="title">订单列表</view>
          <view class="muted">暂无有效订单</view>
        </view>

        <block wx:else>
          <view class="card">
            <view class="section-head" bindtap="togglePendingCollapsed">
              <view>
                <view class="title no-margin">{{pendingTitle}}（{{pendingOrders.length}}）</view>
                <view class="muted small section-note" wx:if="{{pendingNote}}">{{pendingNote}}</view>
              </view>
              <view class="fold-btn">{{pendingCollapsed ? '展开' : '收起'}}</view>
            </view>
            <block wx:if="{{!pendingCollapsed}}">
              <view class="sale-stats-empty muted small" wx:if="{{pendingOrders.length===0}}">{{emptyPendingText}}</view>
              <block wx:else>
                <view class="muted small" wx:if="{{listActionHint}}">{{listActionHint}}</view>
                <view class="order-row" wx:for="{{pendingOrders}}" wx:key="_id" data-id="{{item._id}}" bindtap="onOpenOrderActions" hover-class="order-row-hover">
                  <view class="order-main">
                    <view class="order-top">
                      <text class="name">{{item.customerNameText}}</text>
                      <text class="amount">€{{item.amountEuro}}</text>
                    </view>
                    <view class="meta-line">
                      <text class="tag {{item.fulfillmentType==='pickup' ? 'pickup' : 'delivery'}}">{{item.fulfillmentText}}</text>
                      <text class="address">{{item.addressDisplay}}</text>
                    </view>
                    <view class="meta-line compact">
                      <text class="meta-text">电话：{{item.phoneText}}</text>
                    </view>
                    <view class="status-row">
                      <text class="status-pill {{item.isDelivered ? 'ok' : ''}}">{{item.handoffStatusText}}</text>
                      <text class="status-pill {{item.isPaid ? 'ok' : ''}}">{{item.paidStatusText}}</text>
                      <text class="status-pill">{{item.paymentMethodText}}</text>
                    </view>
                  </view>
                </view>
              </block>
            </block>
          </view>

          <view class="card">
            <view class="section-head" bindtap="toggleDeliveredCollapsed">
              <view>
                <view class="title no-margin">{{deliveredTitle}}（{{deliveredOrders.length}}）</view>
                <view class="muted small section-note" wx:if="{{deliveredNote}}">{{deliveredNote}}</view>
              </view>
              <view class="fold-btn">{{deliveredCollapsed ? '展开' : '收起'}}</view>
            </view>
            <block wx:if="{{!deliveredCollapsed}}">
              <view class="sale-stats-empty muted small" wx:if="{{deliveredOrders.length===0}}">{{emptyDeliveredText}}</view>
              <block wx:else>
                <view class="muted small" wx:if="{{listActionHint}}">{{listActionHint}}</view>
                <view class="order-row" wx:for="{{deliveredOrders}}" wx:key="_id" data-id="{{item._id}}" bindtap="onOpenOrderActions" hover-class="order-row-hover">
                  <view class="order-main">
                    <view class="order-top">
                      <text class="name">{{item.customerNameText}}</text>
                      <text class="amount">€{{item.amountEuro}}</text>
                    </view>
                    <view class="meta-line">
                      <text class="tag {{item.fulfillmentType==='pickup' ? 'pickup' : 'delivery'}}">{{item.fulfillmentText}}</text>
                      <text class="address">{{item.addressDisplay}}</text>
                    </view>
                    <view class="meta-line compact">
                      <text class="meta-text">电话：{{item.phoneText}}</text>
                    </view>
                    <view class="status-row">
                      <text class="status-pill {{item.isDelivered ? 'ok' : ''}}">{{item.handoffStatusText}}</text>
                      <text class="status-pill {{item.isPaid ? 'ok' : ''}}">{{item.paidStatusText}}</text>
                      <text class="status-pill">{{item.paymentMethodText}}</text>
                    </view>
                  </view>
                </view>
              </block>
            </block>
          </view>
        </block>
      </block>
    </block>
  </view>
</scroll-view>

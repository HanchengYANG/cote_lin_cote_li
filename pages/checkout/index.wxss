page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7fb;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.page {
  padding: 24rpx;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 18rpx;
}
.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.warn {
  border: 1rpx solid rgba(255, 138, 0, 0.35);
  background: #fffaf2;
}
.muted {
  color: rgba(0, 0, 0, 0.55);
}
.small {
  font-size: 24rpx;
}
.center {
  text-align: center;
  margin-top: 10rpx;
}
.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
.line-left {
  flex: 1;
  min-width: 0;
}
.line-right {
  margin-left: 12rpx;
}
.name {
  font-weight: 600;
}
.hr {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.06);
  margin: 14rpx 0;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sum {
  font-weight: 800;
  font-size: 32rpx;
}
.radio {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
}
.input {
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
  margin-top: 12rpx;
}
.row2 {
  display: flex;
  gap: 12rpx;
}
.half {
  flex: 1;
}
.sug {
  margin-top: 10rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.10);
  border-radius: 14rpx;
  overflow: hidden;
}
.sug-item {
  padding: 14rpx 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}
.sug-item:first-child {
  border-top: none;
}
.sug-label {
  font-size: 26rpx;
}
.slot {
  padding: 16rpx;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.04);
}
.checkbox {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}
.picker {
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 18rpx 16rpx;
  margin-top: 12rpx;
}
.textarea {
  min-height: 160rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 16rpx;
  margin-top: 12rpx;
}
.btn {
  background: #111;
  color: #fff;
  border-radius: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.btn[disabled] {
  opacity: 0.4;
}

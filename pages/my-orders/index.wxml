<navigation-bar title="我的订单" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<sync-guard ready="{{isReady}}" error="{{syncError}}" bindretry="onSyncRetry"></sync-guard>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="card" wx:if="{{initialLoading}}">
      <view class="muted">载入中...</view>
    </view>
    <view class="card" wx:elif="{{initialLoaded && orders.length===0}}">
      <view class="muted">暂无订单</view>
    </view>
    <view class="list" wx:else>
      <view class="item" wx:for="{{orders}}" wx:key="_id" bindtap="goDetail" data-id="{{item._id}}">
        <view class="item-top">
          <view class="tag {{item.statusClass}}">{{item.statusText}}</view>
          <view class="muted small">{{item.createdAtText}}</view>
        </view>
        <view class="item-mid">
          <view class="strong">{{item.fulfillmentText}}</view>
          <view class="muted small" wx:if="{{item.deliveryTimeSlotLabelSnapshot}}">时间段：{{item.deliveryTimeSlotLabelSnapshot}}</view>
        </view>
        <view class="muted small">共 {{item.totals.qty}} 件，€{{item.totals.amountEuro}}</view>
      </view>
    </view>
  </view>
</scroll-view>

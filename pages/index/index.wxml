<navigation-bar title="菜单" back="{{false}}" color="black" background="#FFF">
  <view wx:if="{{isAdmin}}" slot="right" class="nav-entry" bindtap="goAdminHome">店主端</view>
</navigation-bar>
<sync-guard ready="{{isReady}}" error="{{syncError}}" bindretry="onSyncRetry"></sync-guard>
<scroll-view class="scrollarea" scroll-y type="list" refresher-enabled="{{true}}" refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onPullDownRefresh">
  <view class="page">
    <view class="info-strip">
      <view class="info-main">
        <text wx:if="{{isHydrating}}" class="muted">菜单加载中...</text>
        <text wx:elif="{{saleInfo.status!=='OPEN' && !customerOrderProgressText}}" class="muted">当前未开单，可先加购物车，开单后再提交订单。</text>
        <text wx:elif="{{saleInfo.status==='OPEN' && !customerOrderProgressText}}" class="muted">当前开单中</text>
        <view wx:if="{{shouldShowDeliverySlot}}" class="info-subline">
          <text class="muted">本次配送时间：{{saleInfo.deliveryTimeSlotLabel}}</text>
        </view>
        <view wx:if="{{customerOrderProgressText}}" class="info-subline info-progress-line">
          <text class="muted">{{customerOrderProgressText}}</text>
        </view>
      </view>
      <view wx:if="{{saleInfo.note}}" class="notice-inline">
        <view class="notice-divider"></view>
        <view class="notice-head">
          <view class="notice-title">本次说明</view>
          <view wx:if="{{noticeCanToggle}}" class="notice-toggle" bindtap="toggleNoticeCollapsed">{{noticeCollapsed ? '展开' : '收起'}}</view>
        </view>
        <view wx:if="{{noticeCollapsed}}" class="notice-text collapsed">{{noticePreviewText}}</view>
        <view wx:else class="notice-text expanded">
          <view wx:for="{{noticeLines}}" wx:key="index" class="notice-line">{{item || ' '}}</view>
        </view>
      </view>
    </view>

    <view class="error-strip" wx:if="{{lastErrorMsg}}">
      <text class="error-text">{{lastErrorMsg}}</text>
      <text class="error-close" bindtap="clearError">关闭</text>
    </view>

    <view class="card" wx:if="{{!isHydrating && dishes.length===0}}">
      <view class="muted">暂无上架菜品</view>
    </view>

    <view wx:elif="{{dishes.length>0}}" class="dish-list">
      <view class="dish-row {{saleInfo.status==='OPEN' && !item.inSale ? 'state-muted' : ''}} {{item.isSoldOut ? 'state-soldout' : ''}}" wx:for="{{dishes}}" wx:key="_id">
        <view class="dish-left" bindtap="goDishDetail" data-id="{{item._id}}">
          <image wx:if="{{item.thumb}}" class="dish-thumb" mode="aspectFill" src="{{item.thumb}}" />
          <view wx:else class="dish-thumb placeholder">暂无图片</view>
        </view>
        <view class="dish-center" bindtap="goDishDetail" data-id="{{item._id}}">
          <view class="dish-name">{{item.name}}</view>
          <view class="dish-desc" wx:if="{{item.descPlain}}">{{item.descPlain}}</view>
          <view class="dish-spec">{{item.piecesPerOrderQtyText}}</view>
          <view class="price-row">
            <view class="dish-price">€{{item.priceEuro}}</view>
            <view class="badge {{item.statusClass}}">{{item.statusText}}</view>
          </view>
          <view class="dish-meta" wx:if="{{saleInfo.status==='OPEN' && item.inSale && !item.isSoldOut}}">剩余 {{item.remainingQty}}</view>
        </view>
        <view class="dish-right">
          <button class="qty-btn minus-btn" size="mini" bindtap="dec" data-id="{{item._id}}" disabled="{{item.qty<=0}}">-</button>
          <text class="qty">{{item.qty}}</text>
          <button class="qty-btn plus-btn" size="mini" bindtap="inc" data-id="{{item._id}}" disabled="{{!item.canAdd || (saleInfo.status==='OPEN' && item.inSale && item.qty>=item.remainingQty)}}">+</button>
        </view>
      </view>
    </view>

    <view class="bottom-bar">
      <view class="bottom-left">
        <view class="muted small">已选 {{totalQty}} 件</view>
        <view class="sum">合计 €{{totalAmountEuro}}</view>
      </view>
      <view class="bottom-actions">
        <button class="btn ghost my-orders-btn" bindtap="goMe">我的</button>
        <button class="btn checkout-btn" disabled="{{totalQty===0}}" bindtap="goCheckout">去结算</button>
      </view>
    </view>
  </view>
</scroll-view>

<view wx:if="{{showNicknamePopup}}" class="nickname-popup-mask" catchtouchmove="noop" catchtap="noop">
  <view class="nickname-popup-card" catchtap="noop">
    <view class="nickname-popup-title">先填个昵称</view>
    <view class="nickname-popup-desc">首次使用仅需填写昵称，之后可在“我的”页面修改。</view>
    <input
      class="nickname-popup-input"
      type="nickname"
      placeholder="请输入昵称"
      value="{{nicknameDraft}}"
      bindinput="onNicknamePopupInput"
      maxlength="40"
      focus="{{showNicknamePopup}}"
    />
    <view wx:if="{{nicknamePopupError}}" class="nickname-popup-error">{{nicknamePopupError}}</view>
    <button
      class="btn nickname-popup-save"
      loading="{{nicknameSaving}}"
      disabled="{{nicknameSaving || !nicknameDraft}}"
      bindtap="saveNicknameFromPopup"
    >保存昵称</button>
  </view>
</view>

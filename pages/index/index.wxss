/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6f7fb;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 24rpx 24rpx 140rpx;
}

.admin-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 18rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: rgba(0, 0, 0, 0.55);
}

.small {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.spacer {
  height: 16rpx;
}

.list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
}

.dish {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.dish:last-child {
  border-bottom: none;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
}

.dish-price {
  margin-top: 6rpx;
  color: rgba(0, 0, 0, 0.6);
  font-size: 26rpx;
}

.dish-ops {
  display: flex;
  align-items: center;
}

.qty {
  width: 64rpx;
  text-align: center;
  font-size: 30rpx;
}

.qty-btn {
  width: 64rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #111;
  color: #fff;
}

.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: #fff;
  border-radius: 22rpx;
  padding: 18rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 18rpx 50rpx rgba(0, 0, 0, 0.14);
}

.bottom-left {
  display: flex;
  flex-direction: column;
}

.sum {
  margin-top: 6rpx;
  font-weight: 800;
  font-size: 30rpx;
}

.btn {
  background: #111;
  color: #fff;
  border-radius: 18rpx;
  padding: 0 24rpx;
  height: 76rpx;
  line-height: 76rpx;
}

.btn[disabled] {
  opacity: 0.4;
}

.btn.ghost {
  background: transparent;
  color: #111;
  border: 1rpx solid rgba(0, 0, 0, 0.18);
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 16rpx;
}

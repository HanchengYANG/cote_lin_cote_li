/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 20rpx 24rpx 150rpx;
}

.actions-row {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 12rpx;
}

.actions-row .btn {
  margin-right: 12rpx;
}

.info-strip {
  background: #fffbe8;
  border: 1rpx solid #f1e1a6;
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 14rpx;
}
.error-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  background: #fff1f0;
  border: 1rpx solid #ffccc7;
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 14rpx;
}
.error-text {
  flex: 1;
  min-width: 0;
  color: #a8071a;
  font-size: 24rpx;
  word-break: break-all;
}
.error-close {
  color: #a8071a;
  font-size: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
}

.muted {
  color: rgba(0, 0, 0, 0.55);
}

.small {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.dish-list {
  display: flex;
  flex-direction: column;
}

.dish-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 18rpx;
  padding: 12rpx;
  margin-bottom: 14rpx;
}

.dish-left {
  width: 176rpx;
  height: 176rpx;
  flex: none;
}

.dish-center {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.dish-right {
  width: 190rpx;
  margin-left: 10rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}

.dish-name {
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.3;
  min-height: 80rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.price-row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}

.dish-price {
  color: #1d1d1f;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.dish-thumb {
  width: 176rpx;
  height: 176rpx;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.06);
}

.dish-thumb.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(0, 0, 0, 0.45);
  font-size: 24rpx;
}

.badge {
  margin-left: 12rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  height: 36rpx;
  padding: 0 14rpx;
  font-size: 20rpx;
}

.badge.ok {
  color: #fff;
  background: #111;
}

.badge.sold-out {
  color: #666;
  background: #ececec;
}

.badge.closed {
  color: #666;
  background: #f2f2f2;
}

.badge.not-open {
  color: #666;
  background: #f2f2f2;
}

.dish-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  min-height: 62rpx;
}

.dish-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.48);
}

.qty {
  min-width: 40rpx;
  margin: 0 8rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.qty-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: 700;
}

.qty-btn::after {
  border: none;
}

.minus-btn {
  background: #ef4444;
  color: #fff;
}

.plus-btn {
  background: #f0d93a;
  color: #111;
}

.qty-btn[disabled] {
  opacity: 0.3;
}

.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: #fff;
  border-radius: 22rpx;
  padding: 18rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.12);
}

.bottom-left {
  display: flex;
  flex-direction: column;
}

.sum {
  margin-top: 6rpx;
  font-weight: 800;
  font-size: 30rpx;
}

.btn {
  background: #111;
  color: #fff;
  border-radius: 18rpx;
  padding: 0 24rpx;
  height: 76rpx;
  line-height: 76rpx;
}

.btn[disabled] {
  opacity: 0.4;
}

.btn.ghost {
  background: transparent;
  color: #111;
  border: 1rpx solid rgba(0, 0, 0, 0.18);
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 16rpx;
}

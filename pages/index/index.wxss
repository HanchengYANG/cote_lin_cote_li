/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #eef1f5;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 20rpx 20rpx 180rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.nav-entry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(17, 24, 39, 0.12);
  color: rgba(17, 24, 39, 0.86);
  font-size: 24rpx;
  line-height: 1;
}

.info-strip,
.error-strip,
.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.info-strip {
  margin-bottom: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(250, 204, 21, 0.28);
  background: linear-gradient(180deg, #fffdf4 0%, #fff8dd 100%);
}

.info-main {
  min-width: 0;
}

.notice-inline {
  margin-top: 14rpx;
}

.notice-divider {
  width: 100%;
  height: 1rpx;
  background: rgba(15, 23, 42, 0.08);
  margin-bottom: 12rpx;
}

.notice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.notice-title {
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
}

.notice-toggle {
  flex: none;
  color: #175cd3;
  font-size: 22rpx;
  line-height: 1.2;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(23, 92, 211, 0.12);
}

.notice-text {
  margin-top: 12rpx;
  color: #344054;
  font-size: 24rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.notice-text.collapsed {
  white-space: normal;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.notice-text.expanded {
  white-space: pre-wrap;
}

.error-strip {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(239, 68, 68, 0.22);
  background: linear-gradient(180deg, #fff6f6 0%, #fff1f1 100%);
}

.error-text {
  flex: 1;
  min-width: 0;
  color: #b42318;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.error-close {
  flex: none;
  color: #b42318;
  font-size: 24rpx;
  line-height: 1.4;
}

.card {
  margin-bottom: 16rpx;
  padding: 24rpx 22rpx;
}

.muted {
  color: #667085;
  line-height: 1.45;
}

.small {
  font-size: 22rpx;
}

.dish-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.dish-row {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 12rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.07);
  border: 1rpx solid rgba(15, 23, 42, 0.04);
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.dish-row.state-muted {
  background: #fbfcfd;
}

.dish-row.state-soldout .dish-thumb {
  opacity: 0.78;
}

.dish-left {
  width: 100%;
  height: 236rpx;
  flex: none;
}

.dish-thumb {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
  background: rgba(15, 23, 42, 0.06);
}

.dish-thumb.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #f5f7fb 0%, #edf1f6 100%);
  color: #98a2b3;
  font-size: 22rpx;
}

.dish-center {
  flex: 1;
  min-width: 0;
  margin-left: 0;
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
}

.dish-name {
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  min-height: 76rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dish-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #667085;
  min-height: 60rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.price-row {
  margin-top: auto;
  padding-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.dish-price {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.badge {
  flex: none;
  max-width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 34rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.badge.ok {
  color: #027a48;
  background: #ecfdf3;
  border: 1rpx solid rgba(2, 122, 72, 0.16);
}

.badge.sold-out {
  color: #b42318;
  background: #fff1f3;
  border: 1rpx solid rgba(180, 35, 24, 0.12);
}

.badge.closed,
.badge.not-open {
  color: #475467;
  background: #f2f4f7;
  border: 1rpx solid rgba(71, 84, 103, 0.10);
}

.dish-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #475467;
}

.dish-right {
  width: 100%;
  box-sizing: border-box;
  margin-left: 0;
  margin-top: 12rpx;
  padding: 8rpx 10rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: #f8fafc;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 16rpx;
}

.qty {
  flex: 1;
  min-width: 0;
  text-align: center;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.qty-btn {
  width: 58rpx;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: 700;
}

.qty-btn::after {
  border: none;
}

.minus-btn {
  background: #fee4e2;
  color: #d92d20;
}

.plus-btn {
  background: #fce96a;
  color: #111827;
}

.qty-btn[disabled] {
  opacity: 0.36;
}

.bottom-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  padding: 18rpx;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 24rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.14);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.bottom-left {
  flex: 0 0 auto;
  min-width: 180rpx;
  max-width: 42%;
}

.bottom-left .muted {
  color: #667085;
}

.bottom-left .small {
  font-size: 22rpx;
  white-space: nowrap;
}

.sum {
  margin-top: 6rpx;
  color: #101828;
  font-weight: 800;
  font-size: 30rpx;
  line-height: 1.15;
  white-space: nowrap;
}

.bottom-actions {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.btn {
  flex: 1 1 0;
  min-width: 0;
  height: 78rpx;
  line-height: 78rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: #111827;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
}

.btn::after {
  border: none;
}

.btn[disabled] {
  opacity: 0.42;
}

.btn.ghost {
  background: #f8fafc;
  color: #111827;
  border: 1rpx solid rgba(17, 24, 39, 0.10);
}

.my-orders-btn {
  flex: 0.88 1 0;
}

.checkout-btn {
  flex: 1.12 1 0;
}

.nickname-popup-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  background: rgba(15, 23, 42, 0.44);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.nickname-popup-card {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.22);
  padding: 28rpx 24rpx 24rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.nickname-popup-title {
  color: #101828;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.2;
}

.nickname-popup-desc {
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.nickname-popup-input {
  margin-top: 20rpx;
  width: 100%;
  min-height: 84rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid rgba(15, 23, 42, 0.10);
  box-sizing: border-box;
  color: #101828;
  font-size: 28rpx;
}

.nickname-popup-error {
  margin-top: 12rpx;
  color: #b42318;
  font-size: 22rpx;
  line-height: 1.4;
}

.nickname-popup-save {
  margin-top: 20rpx;
  width: 100%;
}

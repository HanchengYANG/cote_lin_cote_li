<navigation-bar title="{{pageTitle}}" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<sync-guard ready="{{isReady}}" error="{{syncError}}" bindretry="onSyncRetry"></sync-guard>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="card" wx:if="{{loadPhase!=='ready'}}">
      <view class="muted">载入中...</view>
    </view>
    <block wx:else>
      <view class="card">
        <view class="title">常用功能</view>
        <view class="action-row">
          <button class="btn ghost half-btn" bindtap="goMyOrders">我的订单</button>
          <button class="btn ghost half-btn" bindtap="goAddressBook">地址管理</button>
        </view>
        <view class="muted small">微信号小程序无法自动获取，店主将通过你填写的电话联系你。</view>
      </view>

      <view class="card">
        <view class="title">昵称</view>
        <input class="input" type="nickname" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNickInput" />
      </view>

      <view class="card">
        <view class="title">联系电话（自取用）</view>
        <input class="input" placeholder="可选，填写后自取下单可自动带出" value="{{profilePhone}}" bindinput="onPhoneInput" />
      </view>

      <view class="card">
        <view class="title">默认地址</view>
        <view class="muted">{{defaultAddressSummary}}</view>
        <view class="muted small">如需修改默认地址，请进入“地址管理”。</view>
      </view>

      <button class="btn" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存</button>
    </block>
  </view>
</scroll-view>
